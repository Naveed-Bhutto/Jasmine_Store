<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Jasmine Store — affordable elegance for everyday living. Curated elegant, feminine & modern finds from AliExpress, Daraz and Amazon." />
  <title>Jasmine Store — Affordable Elegance for Everyday Living</title>

  <!-- ============ GOOGLE FONTS (Cormorant Garamond for headings + Inter for body) ============ -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
  /* ==========================================================================
     1. DESIGN TOKENS — palette drawn directly from the Jasmine Store logo
     ========================================================================== */
  :root {
    /* Surfaces (soft cream, like the logo background) */
    --bg:            #f7f2e6;   /* warm ivory                        */
    --bg-soft:       #f1ead9;   /* deeper cream for alt sections     */
    --card:          #fffdf7;   /* near-white card                   */
    --border:        rgba(107, 124, 88, 0.16);
    --border-strong: rgba(107, 124, 88, 0.32);

    /* Text (charcoal-green, matching the logotype) */
    --text:          #3d4a34;
    --text-muted:    #6f7a63;
    --text-faint:    #98a08b;

    /* Accents */
    --sage:          #6f8a5e;   /* jasmine-leaf green                */
    --sage-2:        #55704a;
    --sage-deep:     #435c3a;
    --gold:          #c9a86a;   /* warm gold, like the flower centre */
    --gold-soft:     #e8d9b8;
    --blush:         #e9d8c8;
    --star:          #d3a548;
    --danger:        #c25e5e;

    /* Platform brand colours */
    --ali:           #ff4747;
    --daraz:         #f57224;
    --amazon:        #ff9900;

    /* Effects */
    --radius:        18px;
    --radius-sm:     10px;
    --shadow:        0 12px 34px rgba(80, 90, 60, 0.14);
    --shadow-soft:   0 6px 20px rgba(80, 90, 60, 0.10);
    --shadow-glow:   0 8px 26px rgba(111, 138, 94, 0.35);
    --transition:    0.28s cubic-bezier(0.4, 0, 0.2, 1);

    /* Layout */
    --container:     1200px;
    --nav-h:         74px;
  }

  /* ==========================================================================
     2. RESET & BASE
     ========================================================================== */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  h1, h2, h3, .serif {
    font-family: "Cormorant Garamond", Georgia, serif;
  }

  img { display: block; max-width: 100%; }
  a   { color: inherit; text-decoration: none; }
  button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  input  { font: inherit; }

  .container {
    width: min(var(--container), 100% - 2.5rem);
    margin-inline: auto;
  }

  /* Decorative gradient blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }

  /* ==========================================================================
     3. NAVIGATION BAR (sticky)
     ========================================================================== */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    background: rgba(247, 242, 230, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--transition);
  }
  .nav.scrolled { box-shadow: var(--shadow-soft); }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    white-space: nowrap;
  }
  .logo-mark {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border);
  }
  .logo-text {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.06em;
    color: var(--sage-deep);
    line-height: 1.05;
  }
  .logo-text small {
    display: block;
    font-family: "Inter", sans-serif;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.42em;
    color: var(--gold);
    text-transform: uppercase;
  }

  /* Search bar */
  .search-wrap {
    flex: 1;
    max-width: 440px;
    margin-inline: auto;
    position: relative;
  }
  .search-wrap svg {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    width: 17px; height: 17px;
    stroke: var(--text-faint);
    pointer-events: none;
  }
  #searchInput {
    width: 100%;
    padding: 0.65rem 1rem 0.65rem 2.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--card);
    color: var(--text);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  #searchInput::placeholder { color: var(--text-faint); }
  #searchInput:focus {
    border-color: var(--sage);
    box-shadow: 0 0 0 4px rgba(111, 138, 94, 0.18);
  }

  /* Quick platform filters in the nav (desktop only) */
  .nav-filters { display: flex; gap: 0.4rem; }
  .nav-filters button {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid transparent;
    transition: all var(--transition);
  }
  .nav-filters button:hover { color: var(--sage-deep); background: rgba(111, 138, 94, 0.10); }
  .nav-filters button.active {
    color: #fff;
    background: linear-gradient(135deg, var(--sage), var(--sage-2));
    box-shadow: var(--shadow-glow);
  }

  @media (max-width: 900px) {
    .nav-filters { display: none; }
    .logo-text   { display: none; }
  }
  @media (max-width: 900px) and (min-width: 480px) {
    .logo-text { display: block; }
  }

  /* ==========================================================================
     4. HERO SECTION
     ========================================================================== */
  .hero {
    position: relative;
    padding: clamp(3.5rem, 8vw, 6rem) 0 clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero .blob.b1 { width: 460px; height: 460px; background: var(--gold-soft); top: -160px; left: -140px; }
  .hero .blob.b2 { width: 420px; height: 420px; background: #cdddc0; bottom: -180px; right: -120px; }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-logo  { order: -1; max-width: 420px; margin-inline: auto; }
    .hero-ctas, .hero-badge { justify-content: center; }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--card);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
  }
  .hero-badge .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--sage);
    box-shadow: 0 0 0 4px rgba(111, 138, 94, 0.22);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { transform: scale(1);    opacity: 1;   }
    50%      { transform: scale(1.35); opacity: 0.6; }
  }

  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.1rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--sage-deep);
  }
  .hero h1 em {
    font-style: italic;
    color: var(--gold);
  }

  .hero p.sub {
    max-width: 560px;
    margin: 1.2rem 0 2.2rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.12rem);
  }
  @media (max-width: 860px) { .hero p.sub { margin-inline: auto; } }

  .hero-ctas {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 1.9rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--sage), var(--sage-2));
    color: #fff;
    box-shadow: var(--shadow-glow);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(111, 138, 94, 0.45); }
  .btn-ghost {
    border: 1px solid var(--border-strong);
    color: var(--sage-deep);
    background: var(--card);
  }
  .btn-ghost:hover { transform: translateY(-3px); background: #fff; box-shadow: var(--shadow-soft); }

  /* Hero logo panel */
  .hero-logo {
    position: relative;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
    background: var(--card);
    transform: rotate(1.2deg);
    transition: transform var(--transition);
  }
  .hero-logo:hover { transform: rotate(0deg) scale(1.015); }
  .hero-logo img { width: 100%; height: auto; }

  /* Hero trust stats */
  .hero-stats {
    display: flex;
    gap: clamp(1.4rem, 4vw, 3rem);
    margin-top: 2.6rem;
    flex-wrap: wrap;
  }
  @media (max-width: 860px) { .hero-stats { justify-content: center; } }
  .stat b {
    display: block;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--sage-deep);
  }
  .stat span { color: var(--text-faint); font-size: 0.85rem; font-weight: 500; }

  /* ==========================================================================
     5. BRAND STORY
     ========================================================================== */
  .story {
    position: relative;
    padding: 4rem 0;
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
    text-align: center;
    overflow: hidden;
  }
  .story .blob.b4 { width: 380px; height: 380px; background: var(--gold-soft); top: -180px; right: 15%; }
  .story-inner { position: relative; z-index: 1; max-width: 760px; margin-inline: auto; }
  .story .flower { font-size: 1.8rem; margin-bottom: 0.6rem; }
  .story h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--sage-deep);
  }
  .story h2 span { color: var(--gold); font-style: italic; }
  .story p {
    margin-top: 1.1rem;
    color: var(--text-muted);
    font-size: clamp(0.98rem, 2vw, 1.08rem);
  }
  .story .tagline {
    margin-top: 1.6rem;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    font-style: italic;
    font-weight: 600;
    color: var(--sage);
  }

  /* ==========================================================================
     6. FILTER PILLS
     ========================================================================== */
  .filters {
    position: relative;
    z-index: 2;
    padding: 3rem 0 1.8rem;
  }
  .filters-row {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .filters-label {
    text-align: center;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-faint);
    margin-bottom: 0.8rem;
  }
  .pill {
    padding: 0.55rem 1.3rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--card);
    border: 1px solid var(--border);
    transition: all var(--transition);
  }
  .pill:hover { color: var(--sage-deep); border-color: var(--border-strong); transform: translateY(-2px); }
  .pill.active {
    color: #fff;
    background: linear-gradient(135deg, var(--sage), var(--sage-2));
    border-color: transparent;
    box-shadow: var(--shadow-glow);
  }
  .pill.cat.active {
    background: linear-gradient(135deg, var(--gold), #b3904f);
    box-shadow: 0 6px 18px rgba(201, 168, 106, 0.45);
  }
  .filters-row + .filters-label { margin-top: 1.4rem; }

  /* ==========================================================================
     7. PRODUCT GRID & CARDS
     ========================================================================== */
  .products { padding: 1rem 0 4.5rem; position: relative; }

  .section-head { text-align: center; margin-bottom: 2.4rem; }
  .section-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--sage-deep);
  }
  .section-head p { color: var(--text-muted); margin-top: 0.4rem; }

  #resultCount {
    text-align: center;
    color: var(--text-faint);
    font-size: 0.88rem;
    margin-bottom: 1.4rem;
    min-height: 1.4em;                              /* reserve space → no CLS */
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: 1.5rem;
  }

  /* ------- Card ------- */
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    animation: cardIn 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) both;
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(18px) scale(0.98); }
    to   { opacity: 1; transform: none; }
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(111, 138, 94, 0.45);
    box-shadow: var(--shadow);
  }

  /* Fixed aspect-ratio prevents layout shift (CLS-safe) */
  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, rgba(201, 168, 106, 0.14), rgba(111, 138, 94, 0.10));
    overflow: hidden;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .card-media img.loaded { opacity: 1; }
  .card:hover .card-media img { transform: scale(1.06); }

  /* Discount ribbon */
  .ribbon {
    position: absolute;
    top: 12px; left: 12px;
    z-index: 2;
    padding: 0.28rem 0.7rem;
    font-size: 0.74rem;
    font-weight: 800;
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(135deg, var(--gold), #b3904f);
    box-shadow: 0 4px 12px rgba(201, 168, 106, 0.5);
  }

  /* Platform badge */
  .badge {
    position: absolute;
    top: 12px; right: 12px;
    z-index: 2;
    padding: 0.28rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    border-radius: 999px;
    color: #fff;
    text-transform: uppercase;
  }
  .badge.aliexpress { background: var(--ali); }
  .badge.daraz      { background: var(--daraz); }
  .badge.amazon     { background: var(--amazon); color: #1a1200; }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.15rem 1.2rem 1.3rem;
    gap: 0.55rem;
  }
  .card-cat {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .card-title {
    font-family: "Inter", sans-serif;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .card-desc {
    font-size: 0.87rem;
    color: var(--text-muted);
    flex: 1;
  }

  /* Star rating */
  .stars {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.95rem;
    color: var(--star);
    letter-spacing: 1.5px;
  }
  .stars .num {
    margin-left: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  /* Price row */
  .price-row { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .price     { font-size: 1.3rem; font-weight: 800; color: var(--sage-2); letter-spacing: -0.02em; }
  .price-old { font-size: 0.88rem; color: var(--text-faint); text-decoration: line-through; }

  /* Buy button */
  .buy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.78rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: linear-gradient(135deg, var(--sage), var(--sage-2));
    box-shadow: 0 6px 18px rgba(111, 138, 94, 0.3);
    transition: transform var(--transition), box-shadow var(--transition), filter var(--transition);
  }
  .buy-btn:hover  { transform: translateY(-2px); filter: brightness(1.07); box-shadow: 0 10px 26px rgba(111, 138, 94, 0.45); }
  .buy-btn:active { transform: translateY(0); }
  .buy-btn svg    { width: 16px; height: 16px; }

  /* Empty state */
  .empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }
  .empty .big { font-size: 2.6rem; margin-bottom: 0.6rem; }
  .empty button {
    margin-top: 1rem;
    color: var(--sage-2);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ==========================================================================
     8. TESTIMONIALS
     ========================================================================== */
  .testimonials {
    position: relative;
    padding: 4.5rem 0;
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
    overflow: hidden;
  }
  .testimonials .blob.b3 { width: 380px; height: 380px; background: var(--gold-soft); bottom: -220px; left: 40%; }

  .t-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 1.4rem;
    position: relative;
    z-index: 1;
  }
  .t-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.6rem;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .t-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-soft); }
  .t-card .stars { margin-bottom: 0.8rem; }
  .t-card p.quote { font-size: 0.94rem; color: var(--text-muted); font-style: italic; }
  .t-author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.2rem;
  }
  .avatar {
    width: 42px; height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.9rem;
    color: #fff;
    flex-shrink: 0;
  }
  .t-author b    { display: block; font-size: 0.92rem; }
  .t-author span { font-size: 0.78rem; color: var(--text-faint); }

  /* ==========================================================================
     9. FOOTER + NEWSLETTER
     ========================================================================== */
  footer { padding: 4rem 0 2rem; }

  .newsletter {
    background: linear-gradient(135deg, rgba(111, 138, 94, 0.12), rgba(201, 168, 106, 0.14));
    border: 1px solid var(--border-strong);
    border-radius: calc(var(--radius) + 6px);
    padding: clamp(1.8rem, 5vw, 3rem);
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .newsletter h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--sage-deep);
  }
  .newsletter p { color: var(--text-muted); margin: 0.5rem auto 1.5rem; max-width: 500px; }

  .nl-form {
    display: flex;
    gap: 0.6rem;
    max-width: 460px;
    margin-inline: auto;
    flex-wrap: wrap;
    justify-content: center;
  }
  .nl-form input {
    flex: 1;
    min-width: 220px;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--card);
    color: var(--text);
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .nl-form input:focus { border-color: var(--sage); box-shadow: 0 0 0 4px rgba(111, 138, 94, 0.18); }
  .nl-msg { min-height: 1.4em; margin-top: 0.8rem; font-size: 0.88rem; font-weight: 600; color: var(--sage-2); }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .footer-grid h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    margin-bottom: 1rem;
  }
  .footer-grid ul { list-style: none; }
  .footer-grid li { margin-bottom: 0.55rem; }
  .footer-grid a  {
    color: var(--text-muted);
    font-size: 0.92rem;
    transition: color var(--transition);
  }
  .footer-grid a:hover { color: var(--sage-2); }
  .footer-about p { color: var(--text-muted); font-size: 0.9rem; margin-top: 0.9rem; max-width: 300px; }
  .footer-about .logo-mark { width: 52px; height: 52px; }

  .disclosure {
    margin-top: 1.8rem;
    padding: 1rem 1.3rem;
    border-radius: var(--radius-sm);
    background: rgba(111, 138, 94, 0.06);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .copyright {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.6rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  /* Back-to-top */
  #toTop {
    position: fixed;
    right: 1.4rem;
    bottom: 1.4rem;
    z-index: 90;
    width: 46px; height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--sage), var(--sage-2));
    color: #fff;
    box-shadow: var(--shadow-glow);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity var(--transition), transform var(--transition);
  }
  #toTop.show { opacity: 1; transform: none; pointer-events: auto; }
  #toTop:hover { transform: translateY(-3px); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
  </style>
</head>

<body>

  <!-- ================= NAVIGATION ================= -->
  <header class="nav" id="navbar">
    <div class="container nav-inner">
      <a href="#top" class="logo" aria-label="Jasmine Store home">
        <img class="logo-mark" src="data:image/jpeg;base64," alt="Jasmine Store logo" width="44" height="44" />
        <span class="logo-text">Jasmine<small>Store</small></span>
      </a>

      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input id="searchInput" type="search" placeholder="Search elegant finds… (e.g. candle, vase)" aria-label="Search products" />
      </div>

      <nav class="nav-filters" id="navFilters" aria-label="Platform filters"></nav>
    </div>
  </header>

  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="blob b1"></div>
    <div class="blob b2"></div>
    <div class="container hero-inner">
      <div>
        <div class="hero-badge"><span class="dot"></span> New elegant finds added weekly</div>
        <h1>Affordable <em>Elegance</em> for Everyday Living</h1>
        <p class="sub">Handpicked deals &amp; honest reviews — elegant, feminine and modern finds from AliExpress, Daraz &amp; Amazon that make everyday living feel beautifully luxurious.</p>
        <div class="hero-ctas">
          <a href="#deals" class="btn btn-primary">🌸 Shop the Collection</a>
          <a href="#story" class="btn btn-ghost">Our Story</a>
        </div>
        <div class="hero-stats">
          <div class="stat"><b>50K+</b><span>Happy Customers</span></div>
          <div class="stat"><b>4.8★</b><span>Avg. Find Rating</span></div>
          <div class="stat"><b>3</b><span>Trusted Platforms</span></div>
        </div>
      </div>
      <div class="hero-logo">
        <img src="data:image/jpeg;base64," alt="Jasmine Store — floral monogram logo" width="900" height="491" />
      </div>
    </div>
  </section>

  <!-- ================= BRAND STORY ================= -->
  <section class="story" id="story">
    <div class="blob b4"></div>
    <div class="container story-inner">
      <div class="flower">🌼</div>
      <h2>The <span>Jasmine Store</span> Story</h2>
      <p>Jasmine Store brings elegant, feminine, and modern finds that make everyday living feel beautifully luxurious.</p>
      <p>We curate thoughtful, trend-conscious pieces that add warmth, style, and personality to your home and lifestyle.</p>
      <p class="tagline">"Because true luxury isn't about spending more — it's about choosing beautifully."</p>
    </div>
  </section>

  <!-- ================= FILTERS ================= -->
  <section class="filters container" id="deals">
    <p class="filters-label">Filter by platform</p>
    <div class="filters-row" id="platformPills" role="tablist" aria-label="Platform filters"></div>
    <p class="filters-label">Filter by category</p>
    <div class="filters-row" id="categoryPills" role="tablist" aria-label="Category filters"></div>
  </section>

  <!-- ================= PRODUCT GRID ================= -->
  <main class="products container">
    <div class="section-head">
      <h2>🌸 This Week's Curated Finds</h2>
      <p>Every piece is handpicked, every link checked, every price verified.</p>
    </div>
    <p id="resultCount" aria-live="polite"></p>
    <div class="grid" id="productGrid"></div>
  </main>

  <!-- ================= TESTIMONIALS ================= -->
  <section class="testimonials" id="reviews">
    <div class="blob b3"></div>
    <div class="container">
      <div class="section-head">
        <h2>💬 Loved by Our Community</h2>
        <p>Real words from women who chose beautifully.</p>
      </div>
      <div class="t-grid" id="testimonialGrid"></div>
    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="container" id="about">
    <!-- Newsletter -->
    <div class="newsletter">
      <h3>💌 The Jasmine Edit</h3>
      <p>Join thousands of subscribers receiving our weekly edit of elegant, hand-verified finds — straight to your inbox. No spam, only beauty.</p>
      <form class="nl-form" id="nlForm" novalidate>
        <input type="email" id="nlEmail" placeholder="you@example.com" aria-label="Email address" required />
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
      <p class="nl-msg" id="nlMsg" aria-live="polite"></p>
    </div>

    <div class="footer-grid">
      <div class="footer-about">
        <a href="#top" class="logo">
          <img class="logo-mark" src="data:image/jpeg;base64," alt="Jasmine Store logo" width="52" height="52" />
          <span class="logo-text">Jasmine<small>Store</small></span>
        </a>
        <p>Affordable elegance for everyday living. Reader-supported curation — we earn a small commission when you buy through our links, at zero extra cost to you.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="#deals">Curated Finds</a></li>
          <li><a href="#story">Our Story</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#top">Back to Top</a></li>
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href="#" data-placeholder>Privacy Policy</a></li>
          <li><a href="#" data-placeholder>Affiliate Disclosure</a></li>
          <li><a href="#" data-placeholder>Terms of Service</a></li>
          <li><a href="#" data-placeholder>Cookie Policy</a></li>
        </ul>
      </div>
      <div>
        <h4>Platforms</h4>
        <ul>
          <li><a href="#" data-placeholder>AliExpress Finds</a></li>
          <li><a href="#" data-placeholder>Daraz.pk Finds</a></li>
          <li><a href="#" data-placeholder>Amazon Finds</a></li>
        </ul>
      </div>
    </div>

    <p class="disclosure">
      <strong>Affiliate Disclosure:</strong> Jasmine Store participates in affiliate programs including the AliExpress Partner Program, Daraz Affiliate Program and Amazon Associates. As an affiliate we may earn commissions from qualifying purchases made through links on this site. Prices and availability are accurate as of the time of publication and are subject to change.
    </p>

    <div class="copyright">
      <span>© <span id="year"></span> Jasmine Store. All rights reserved.</span>
      <span>Made with 🌸 — choosing beautifully.</span>
    </div>
  </footer>

  <!-- Back-to-top button -->
  <button id="toTop" aria-label="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <script>
  /* ==========================================================================
     Jasmine Store — Vanilla JS
     Sections:
       1. Product data
       2. Placeholder image generator (SVG data-URIs → zero network requests)
       3. State & DOM references
       4. Rendering (pills, cards, testimonials)
       5. Filtering & search logic
       6. Lazy-loading via IntersectionObserver
       7. Misc UI (nav shadow, back-to-top, newsletter, footer year)
     ========================================================================== */

  /* ------------------------------------------------------------------
     1. PRODUCT DATA
     ------------------------------------------------------------------
     Swap `imageURL` with a real product photo URL and `affiliateLink`
     with your tracked affiliate URL. If `imageURL` is left empty, an
     elegant branded SVG placeholder is generated automatically.
  ------------------------------------------------------------------ */
  /* PRODUCTS_START — do not remove this marker (used by tools/update_products.py) */
  const PRODUCTS = [
    {
        "id": 1,
        "title": "Nordic Ceramic Vase Set (3-Piece)",
        "description": "Minimal matte ceramics in cream & sage. Instantly elevates any shelf, console or dining table.",
        "price": 18.99,
        "originalPrice": 39.99,
        "platform": "AliExpress",
        "category": "Home Décor",
        "rating": 4.7,
        "imageURL": "",
        "emoji": "🏺",
        "tint": "#c9a86a",
        "affiliateLink": "https://s.click.aliexpress.com/e/EXAMPLE1"
    },
    {
        "id": 2,
        "title": "Gold-Plated Pearl Jewellery Set",
        "description": "18k gold-plated necklace, earrings & bracelet with freshwater pearls. Timeless, tarnish-resistant.",
        "price": 2799,
        "originalPrice": 5500,
        "currency": "Rs.",
        "platform": "Daraz",
        "category": "Jewellery",
        "rating": 4.6,
        "imageURL": "",
        "emoji": "📿",
        "tint": "#e0b84f",
        "affiliateLink": "https://www.daraz.pk/products/EXAMPLE2"
    },
    {
        "id": 3,
        "title": "Scented Soy Candle Trio — Jasmine, Vanilla & Rose",
        "description": "Hand-poured, 45-hour burn each. Turns an ordinary evening into a spa ritual.",
        "price": 21.95,
        "originalPrice": 42.0,
        "platform": "Amazon",
        "category": "Home Décor",
        "rating": 4.8,
        "imageURL": "",
        "emoji": "🕯️",
        "tint": "#d8a48f",
        "affiliateLink": "https://amzn.to/EXAMPLE3"
    },
    {
        "id": 4,
        "title": "LED Vanity Mirror with Touch Dimmer",
        "description": "Hollywood-style lighting in 3 tones. Flawless makeup in any room, day or night.",
        "price": 26.5,
        "originalPrice": 54.99,
        "platform": "AliExpress",
        "category": "Beauty",
        "rating": 4.5,
        "imageURL": "",
        "emoji": "🪞",
        "tint": "#b48ec9",
        "affiliateLink": "https://s.click.aliexpress.com/e/EXAMPLE4"
    },
    {
        "id": 5,
        "title": "Mulberry Silk Pillowcase (Champagne)",
        "description": "22-momme pure silk — kind to skin & hair. Wake up smoother, sleep more beautifully.",
        "price": 15.99,
        "originalPrice": 34.99,
        "platform": "AliExpress",
        "category": "Bedroom",
        "rating": 4.7,
        "imageURL": "",
        "emoji": "🛏️",
        "tint": "#e8c9a8",
        "affiliateLink": "https://s.click.aliexpress.com/e/EXAMPLE5"
    },
    {
        "id": 6,
        "title": "Ceramic Aroma Diffuser with Warm Light",
        "description": "Whisper-quiet ultrasonic mist with a soft glow. Your home, but calmer and lovelier.",
        "price": 3499,
        "originalPrice": 6800,
        "currency": "Rs.",
        "platform": "Daraz",
        "category": "Home Décor",
        "rating": 4.6,
        "imageURL": "",
        "emoji": "🌫️",
        "tint": "#8fb996",
        "affiliateLink": "https://www.daraz.pk/products/EXAMPLE6"
    },
    {
        "id": 7,
        "title": "Velvet Jewellery Organizer Box",
        "description": "Three tiers of sage-green velvet luxury. Every ring, chain & earring finally has a home.",
        "price": 17.99,
        "originalPrice": 32.99,
        "platform": "Amazon",
        "category": "Jewellery",
        "rating": 4.9,
        "imageURL": "",
        "emoji": "💍",
        "tint": "#6f8a5e",
        "affiliateLink": "https://amzn.to/EXAMPLE7"
    },
    {
        "id": 8,
        "title": "Satin Scrunchie & Hair Clip Set (12 pcs)",
        "description": "Gentle on hair, gorgeous on wrists. Neutral tones that match every outfit.",
        "price": 6.49,
        "originalPrice": 14.99,
        "platform": "AliExpress",
        "category": "Beauty",
        "rating": 4.4,
        "imageURL": "",
        "emoji": "🎀",
        "tint": "#e3a6b6",
        "affiliateLink": "https://s.click.aliexpress.com/e/EXAMPLE8"
    },
    {
        "id": 9,
        "title": "Boho Rattan Table Lamp",
        "description": "Hand-woven warmth with a soft amber glow. The coziest corner in the house, guaranteed.",
        "price": 4299,
        "originalPrice": 7999,
        "currency": "Rs.",
        "platform": "Daraz",
        "category": "Home Décor",
        "rating": 4.5,
        "imageURL": "",
        "emoji": "🛋️",
        "tint": "#c98d5e",
        "affiliateLink": "https://www.daraz.pk/products/EXAMPLE9"
    },
    {
        "id": 10,
        "title": "Gold-Rimmed Glass Coffee Mug Set",
        "description": "Double-walled elegance for slow mornings. Your latte deserves better than a plain mug.",
        "price": 13.75,
        "originalPrice": 28.0,
        "platform": "Amazon",
        "category": "Kitchen",
        "rating": 4.6,
        "imageURL": "",
        "emoji": "☕",
        "tint": "#c9a86a",
        "affiliateLink": "https://amzn.to/EXAMPLE10"
    },
    {
        "id": 11,
        "title": "Linen Waffle Throw Blanket",
        "description": "Breathable, buttery-soft texture in oat & sage. Drape it once and the sofa is transformed.",
        "price": 24.99,
        "originalPrice": 49.99,
        "platform": "AliExpress",
        "category": "Bedroom",
        "rating": 4.5,
        "imageURL": "",
        "emoji": "🧺",
        "tint": "#a3b18a",
        "affiliateLink": "https://s.click.aliexpress.com/e/EXAMPLE11"
    },
    {
        "id": 12,
        "title": "Marble & Gold Vanity Tray",
        "description": "A five-minute styling trick: corral perfumes & trinkets into one polished moment.",
        "price": 1899,
        "originalPrice": 3600,
        "currency": "Rs.",
        "platform": "Daraz",
        "category": "Beauty",
        "rating": 4.7,
        "imageURL": "",
        "emoji": "✨",
        "tint": "#d9c8a9",
        "affiliateLink": "https://www.daraz.pk/products/EXAMPLE12"
    }
];
  /* PRODUCTS_END — do not remove this marker */

  /* Testimonials data */
  const TESTIMONIALS = [
    { name: "Ayesha K.", role: "Verified Buyer · Karachi", quote: "My whole vanity corner is from Jasmine Store finds. Everything looks twice the price I paid — the curation is genuinely elegant.", rating: 5, color: "#6f8a5e" },
    { name: "Mariam S.", role: "Verified Buyer · Lahore", quote: "The silk pillowcase and candle trio arrived exactly as described. It feels like someone with real taste picked these for me.", rating: 5, color: "#c9a86a" },
    { name: "Hira F.", role: "Home Décor Lover", quote: "I love that Daraz and AliExpress prices are compared side by side. Saved thousands of rupees redecorating my bedroom.", rating: 4, color: "#d8a48f" },
    { name: "Zainab R.", role: "Newsletter Subscriber", quote: "The Jasmine Edit is the only marketing email I actually open. Beautiful finds, honest reviews, real discounts.", rating: 5, color: "#b48ec9" }
  ];

  /* ------------------------------------------------------------------
     2. PLACEHOLDER IMAGE GENERATOR
     ------------------------------------------------------------------
     Produces a lightweight branded SVG (as a data URI) so the demo
     needs zero external images. Replace with real product photos by
     filling in `imageURL` above.
  ------------------------------------------------------------------ */
  function placeholderImage(emoji, tint) {
    const svg =
      `<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
        <defs>
          <radialGradient id="g" cx="50%" cy="42%" r="75%">
            <stop offset="0%" stop-color="${tint}" stop-opacity="0.38"/>
            <stop offset="100%" stop-color="#f4eddc" stop-opacity="1"/>
          </radialGradient>
        </defs>
        <rect width="800" height="600" fill="#f4eddc"/>
        <rect width="800" height="600" fill="url(#g)"/>
        <circle cx="400" cy="270" r="150" fill="rgba(255,255,255,0.55)"/>
        <circle cx="400" cy="270" r="110" fill="rgba(255,255,255,0.7)"/>
        <text x="400" y="330" font-size="150" text-anchor="middle">${emoji}</text>
        <text x="400" y="520" font-size="26" text-anchor="middle" fill="rgba(80,90,60,0.5)"
              font-family="Inter, sans-serif" font-weight="600">Product photo</text>
      </svg>`;
    return "data:image/svg+xml," + encodeURIComponent(svg.replace(/\s+/g, " "));
  }

  /* ------------------------------------------------------------------
     3. STATE & DOM REFERENCES
  ------------------------------------------------------------------ */
  const state = {
    platform: "All",      // active platform filter
    category: "All",      // active category filter
    query: ""             // live search string
  };

  const grid          = document.getElementById("productGrid");
  const resultCount   = document.getElementById("resultCount");
  const searchInput   = document.getElementById("searchInput");
  const platformPills = document.getElementById("platformPills");
  const categoryPills = document.getElementById("categoryPills");
  const navFilters    = document.getElementById("navFilters");

  /* Derive unique filter values from the data itself */
  const PLATFORMS  = ["All", ...new Set(PRODUCTS.map(p => p.platform))];
  const CATEGORIES = ["All", ...new Set(PRODUCTS.map(p => p.category))];

  /* ------------------------------------------------------------------
     4. RENDERING
  ------------------------------------------------------------------ */

  /** Build filter pill buttons for platforms (main row + sticky nav) and categories. */
  function renderPills() {
    // Platform pills — rendered twice (nav quick-filters + main filter row)
    [platformPills, navFilters].forEach(container => {
      container.innerHTML = PLATFORMS.map(p =>
        `<button class="${container === platformPills ? "pill" : ""} ${p === state.platform ? "active" : ""}"
                 data-platform="${p}" role="tab" aria-selected="${p === state.platform}">${p}</button>`
      ).join("");
    });

    // Category pills
    categoryPills.innerHTML = CATEGORIES.map(c =>
      `<button class="pill cat ${c === state.category ? "active" : ""}"
               data-category="${c}" role="tab" aria-selected="${c === state.category}">${c}</button>`
    ).join("");
  }

  /** Convert a numeric rating (e.g. 4.5) into a star string. */
  function starString(rating) {
    const full = Math.floor(rating);
    const half = rating - full >= 0.5 ? 1 : 0;
    return "★".repeat(full) + (half ? "⯨" : "") + "☆".repeat(5 - full - half);
  }

  /** Format prices — supports both USD ($) and PKR (Rs.) products. */
  function money(value, currency) {
    return currency
      ? `${currency} ${value.toLocaleString()}`
      : `$${value.toFixed(2)}`;
  }

  /** Render the product grid based on a filtered list. */
  function renderProducts(list) {
    // Empty state
    if (list.length === 0) {
      grid.innerHTML = `
        <div class="empty">
          <div class="big">🌸</div>
          <h3>No finds match your search</h3>
          <p>Try a different keyword or reset the filters.</p>
          <button id="resetFilters">Reset all filters</button>
        </div>`;
      resultCount.textContent = "0 finds";
      document.getElementById("resetFilters").addEventListener("click", resetFilters);
      return;
    }

    resultCount.textContent = `${list.length} elegant find${list.length !== 1 ? "s" : ""}`;

    grid.innerHTML = list.map((p, i) => {
      const discount = Math.round((1 - p.price / p.originalPrice) * 100);
      const img      = p.imageURL || placeholderImage(p.emoji, p.tint);
      const platformClass = p.platform.toLowerCase().replace(/[^a-z]/g, "");
      return `
      <article class="card" style="animation-delay:${Math.min(i * 45, 400)}ms">
        <div class="card-media">
          <span class="ribbon">-${discount}%</span>
          <span class="badge ${platformClass}">${p.platform}</span>
          <!-- data-src + IntersectionObserver = lazy loading; width/height + aspect-ratio = no CLS -->
          <img data-src="${img}" alt="${p.title}" width="800" height="600" loading="lazy" decoding="async" />
        </div>
        <div class="card-body">
          <span class="card-cat">${p.category}</span>
          <h3 class="card-title">${p.title}</h3>
          <p class="card-desc">${p.description}</p>
          <div class="stars" aria-label="Rated ${p.rating} out of 5">
            ${starString(p.rating)}<span class="num">${p.rating.toFixed(1)}</span>
          </div>
          <div class="price-row">
            <span class="price">${money(p.price, p.currency)}</span>
            <span class="price-old">${money(p.originalPrice, p.currency)}</span>
          </div>
          <a class="buy-btn" href="${p.affiliateLink}" target="_blank" rel="noopener sponsored nofollow">
            Check Price / Buy Now
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M9 7h8v8"/>
            </svg>
          </a>
        </div>
      </article>`;
    }).join("");

    observeLazyImages();   // (re)attach lazy-loading after each render
  }

  /** Render the testimonial cards. */
  function renderTestimonials() {
    document.getElementById("testimonialGrid").innerHTML = TESTIMONIALS.map(t => `
      <article class="t-card">
        <div class="stars">${starString(t.rating)}</div>
        <p class="quote">“${t.quote}”</p>
        <div class="t-author">
          <span class="avatar" style="background:${t.color}">${t.name.charAt(0)}</span>
          <span><b>${t.name}</b><span>${t.role}</span></span>
        </div>
      </article>`).join("");
  }

  /* ------------------------------------------------------------------
     5. FILTERING & SEARCH LOGIC
  ------------------------------------------------------------------ */

  /** Apply all active filters (platform + category + search query) and re-render. */
  function applyFilters() {
    const q = state.query.trim().toLowerCase();

    const filtered = PRODUCTS.filter(p =>
      (state.platform === "All" || p.platform === state.platform) &&
      (state.category === "All" || p.category === state.category) &&
      (q === "" ||
        p.title.toLowerCase().includes(q) ||
        p.description.toLowerCase().includes(q))
    );

    renderPills();            // refresh active pill highlighting
    renderProducts(filtered);
  }

  /** Reset every filter back to defaults. */
  function resetFilters() {
    state.platform = "All";
    state.category = "All";
    state.query    = "";
    searchInput.value = "";
    applyFilters();
  }

  /* Event delegation: one listener handles every pill click. */
  document.addEventListener("click", (e) => {
    const platformBtn = e.target.closest("[data-platform]");
    const categoryBtn = e.target.closest("[data-category]");

    if (platformBtn) {
      state.platform = platformBtn.dataset.platform;
      applyFilters();
      // If the user clicked a quick-filter in the nav, jump to the deals grid
      if (platformBtn.parentElement === navFilters) {
        document.getElementById("deals").scrollIntoView({ behavior: "smooth" });
      }
    }
    if (categoryBtn) {
      state.category = categoryBtn.dataset.category;
      applyFilters();
    }
  });

  /* Real-time search — lightly debounced to avoid re-rendering every keystroke. */
  let searchTimer;
  searchInput.addEventListener("input", () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      state.query = searchInput.value;
      applyFilters();
    }, 120);
  });

  /* ------------------------------------------------------------------
     6. LAZY-LOADING IMAGES (IntersectionObserver)
     ------------------------------------------------------------------
     Cards render with a `data-src` attribute only; the real `src` is
     assigned when the card scrolls near the viewport. Combined with
     the fixed aspect-ratio box in CSS, this keeps CLS at ~0.
  ------------------------------------------------------------------ */
  const lazyObserver = ("IntersectionObserver" in window)
    ? new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const img = entry.target;
          img.src = img.dataset.src;                       // swap in the real source
          img.addEventListener("load", () => img.classList.add("loaded"), { once: true });
          obs.unobserve(img);
        });
      }, { rootMargin: "300px 0px" })                       // pre-load slightly early
    : null;

  function observeLazyImages() {
    document.querySelectorAll("img[data-src]:not([src])").forEach(img => {
      if (lazyObserver) {
        lazyObserver.observe(img);
      } else {
        // Fallback for very old browsers: load immediately
        img.src = img.dataset.src;
        img.classList.add("loaded");
      }
    });
  }

  /* ------------------------------------------------------------------
     7. MISC UI
  ------------------------------------------------------------------ */

  /* Nav shadow + back-to-top visibility on scroll (passive for performance) */
  const navbar  = document.getElementById("navbar");
  const toTop   = document.getElementById("toTop");
  window.addEventListener("scroll", () => {
    navbar.classList.toggle("scrolled", window.scrollY > 8);
    toTop.classList.toggle("show", window.scrollY > 600);
  }, { passive: true });

  toTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  /* Newsletter — client-side validation + friendly feedback (demo only) */
  document.getElementById("nlForm").addEventListener("submit", (e) => {
    e.preventDefault();
    const email = document.getElementById("nlEmail").value.trim();
    const msg   = document.getElementById("nlMsg");
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);

    if (!valid) {
      msg.textContent = "⚠️ Please enter a valid email address.";
      msg.style.color = "var(--danger)";
      return;
    }
    msg.textContent = "🌸 Welcome to The Jasmine Edit! Check your inbox to confirm.";
    msg.style.color = "var(--sage-2)";
    e.target.reset();
  });

  /* Placeholder links (Privacy Policy, etc.) — prevent page jumps */
  document.querySelectorAll("[data-placeholder]").forEach(a =>
    a.addEventListener("click", e => e.preventDefault())
  );

  /* Dynamic copyright year */
  document.getElementById("year").textContent = new Date().getFullYear();

  /* ------------------------------------------------------------------
     INITIAL RENDER
  ------------------------------------------------------------------ */
  renderPills();
  renderTestimonials();
  applyFilters();
  </script>
</body>
</html>
